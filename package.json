{
  "name": "dsh-telegram-bridge",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "extensions",
    "dsh.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm build",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./extensions/dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
